# Variables públicas. Este archivo es una plantilla: copia a `.env` con tus valores reales.
#
# Única variable que consume el bundle del cliente. La site key de Cloudflare Turnstile
# es pública por diseño (el navegador la necesita para renderizar el widget).
VITE_TURNSTILE_SITE_KEY=

# Secreto del Worker de Cloudflare. NO va en este archivo: se configura con:
#   wrangler pages secret put TURNSTILE_SECRET_KEY
# TURNSTILE_SECRET_KEY=

# Access key de Web3Forms. NO va en este archivo: se configura como secreto del Worker con:
#   wrangler pages secret put WEB3FORMS_ACCESS_KEY
# WEB3FORMS_ACCESS_KEY=