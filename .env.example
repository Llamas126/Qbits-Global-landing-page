# Variables públicas que consume el bundle del cliente. Copia a `.env` con tus valores reales.
#
# La Web3Forms access key es pública por diseño (el navegador la necesita para el envío
# client-side). Es la única variable requerida para el envío del formulario.
VITE_WEB3FORMS_ACCESS_KEY=

# La site key de Turnstile es pública por diseño y vive en `src/config.ts` (no es env var).

# Secreto del Worker de Cloudflare. NO va en este archivo: se configura con:
#   wrangler secret put TURNSTILE_SECRET_KEY --name qbits-global
# TURNSTILE_SECRET_KEY=