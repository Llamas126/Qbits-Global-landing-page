# No hay variables de entorno de cliente. La site key de Turnstile está en src/config.ts
# porque es pública por diseño (no es un secreto).

# Secreto del Worker de Cloudflare. NO va en este archivo: se configura con:
#   wrangler pages secret put TURNSTILE_SECRET_KEY
# TURNSTILE_SECRET_KEY=

# Access key de Web3Forms. NO va en este archivo: se configura como secreto del Worker con:
#   wrangler pages secret put WEB3FORMS_ACCESS_KEY
# WEB3FORMS_ACCESS_KEY=